{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Edit(~/repos/thoughts/**)",
      "Edit(.thoughts/**)",
      "Bash",
      "WebSearch",
      "WebFetch",
      "Bash(gws calendar:*)",
      "mcp__claude_ai_Cyvl__list_projects",
      "mcp__claude_ai_Cyvl__geocode_location",
      "mcp__claude_ai_Cyvl__get_project_overview",
      "mcp__claude_ai_Cyvl__search_imagery",
      "mcp__claude_ai_Cyvl__list_inspection_cells",
      "mcp__claude_ai_Cyvl__list_above_ground_assets",
      "mcp__claude_ai_Cyvl__query_infrastructure",
      "mcp__claude_ai_Cyvl__assess_infrastructure",
      "mcp__claude_ai_Cyvl__list_signs"
    ],
    "ask": [
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.kube/**)"
    ]
  },
  "model": "sonnet",
  "effortLevel": "medium",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ask-dangerous-commands.sh"
          }
        ]
      }
    ]
  }
}
