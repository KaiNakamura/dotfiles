{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(.thoughts/**)",
      "Write(.thoughts/**)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(sed *)",
      "Bash(tree *)",
      "Bash(tail *)",
      "Bash(pgrep *)",
      "Bash(ps *)",
      "Bash(sort *)",
      "Bash(dmesg *)",
      "Bash(done)",
      "Bash(ruff *)",
      "Bash(nvidia-smi *)",
      "Bash(tmux ls *)",
      "Bash(tmux capture-pane *)",
      "Bash(tmux list-sessions *)",
      "Bash(tmux list-windows *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh api user *)",
      "Bash(gh repo view *)",
      "Bash(gh issue view *)",
      "Bash(gh search *)",
      "Bash(git branch --show-current)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git push *)",
      "Bash(git log *)",
      "Bash(git worktree list)",
      "Bash(git -C * branch --show-current)",
      "Bash(git -C * diff *)",
      "Bash(git -C * status *)",
      "Bash(git -C * rev-parse *)",
      "Bash(git -C * push *)",
      "Bash(git -C * log *)",
      "Bash(mkdir *)",
      "Bash(head *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(cut *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(paste *)",
      "Bash(fold *)",
      "Bash(nl *)",
      "Bash(fmt *)",
      "Bash(tac *)",
      "Bash(rev *)",
      "Bash(shuf *)",
      "Bash(join *)",
      "Bash(expand *)",
      "Bash(unexpand *)",
      "Bash(comm *)",
      "Bash(cmp *)",
      "Bash(column *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(strings *)",
      "Bash(od *)",
      "Bash(hexdump *)",
      "Bash(md5sum *)",
      "Bash(sha256sum *)",
      "Bash(base64 *)",
      "Bash(which *)",
      "Bash(pwd *)",
      "Bash(date *)",
      "Bash(id *)",
      "Bash(whoami *)",
      "Bash(uname *)",
      "Bash(hostname *)",
      "Bash(uptime *)",
      "Bash(type *)",
      "Bash(printenv *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(free *)",
      "Bash(lsof *)",
      "Bash(nproc *)",
      "Bash(groups *)",
      "Bash(arch *)",
      "Bash(kreadconfig5 *)",
      "Bash(qdbus *)",
      "Bash(xargs *)",
      "Bash(bc *)",
      "Bash(sleep *)",
      "Bash(true *)",
      "Bash(false *)",
      "Bash(cloc *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/auto-approve-allowed-commands.sh"
          }
        ]
      }
    ]
  }
}
