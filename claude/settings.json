{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(~/repos/thoughts/**)",
      "Edit(.thoughts/**)",
      "Bash",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.kube/**)"
    ]
  },
  "model": "sonnet",
  "outputStyle": "default",
  "effortLevel": "medium",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ask-dangerous-commands.sh"
          }
        ]
      }
    ]
  }
}
