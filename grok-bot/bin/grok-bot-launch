#!/bin/bash
# Desktop-entry launcher. Cold start goes through the systemd user service
# (logging + crash relaunch); if Grok Bot is already up, hand the args (e.g. a
# grokbot:// URL) to the running instance via Electron's single-instance lock.
if pgrep -u "$USER" -f '^/opt/Grok Bot/grok-bot( |$)' > /dev/null; then
    exec "/opt/Grok Bot/grok-bot" --ozone-platform=x11 -- "$@"
fi
if systemctl --user reset-failed grok-bot.service 2>/dev/null; \
    systemctl --user start grok-bot.service; then
    # A URL on cold start is forwarded once the instance is up
    if [ $# -gt 0 ]; then
        for _ in $(seq 30); do
            sleep 1
            pgrep -u "$USER" -f '^/opt/Grok Bot/grok-bot( |$)' > /dev/null && break
        done
        sleep 2
        exec "/opt/Grok Bot/grok-bot" --ozone-platform=x11 -- "$@"
    fi
    exit 0
fi
# No user systemd: run the logger directly (no auto-relaunch)
exec "$HOME/.local/bin/grok-bot-logged" "$@"
