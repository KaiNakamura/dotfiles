[Unit]
Description=clipboard owner logger (diagnostic for Grok Bot paste freeze)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/clipwatch/clipwatch.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
