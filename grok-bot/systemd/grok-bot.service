[Unit]
Description=Grok Bot desktop app (logged, relaunched after crashes)
After=graphical-session.target
PartOf=graphical-session.target
# Crash-loop limit: give up after 4 starts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=4

[Service]
Type=simple
ExecStart=%h/.local/bin/grok-bot-logged
# Relaunch on non-zero exit or signal; a clean quit (code 0) stays quit
Restart=on-failure
RestartSec=5
# Electron's renderers and zygotes live in this cgroup; stop them with the app
KillMode=control-group
TimeoutStopSec=15
