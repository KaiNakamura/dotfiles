# pyenv
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - bash)"
eval "$(pyenv virtualenv-init -)"

# pipx
export PIP_REQUIRE_VIRTUALENV=true
export PATH="$PATH:/home/kai/.local/bin"

# TFSwitch
export PATH=$PATH:$HOME/.bin
export PATH=$PATH:$HOME/bin

# uv
export UV_PYTHON_PREFERENCE=only-managed

# roadgnar/build
export CYVL_INCLUDE_ALIASES=1
export CYVL_REPO_PARENT_DIR=~/repos
eval "$(/home/kai/dev/cyvl/build/init shell)"


# pnpm
export PNPM_HOME="/home/kai/.local/share/cyvvy/pnpm-home"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Task
eval "$(task --completion zsh)"

# Override starship config to use Cyvl's
export STARSHIP_CONFIG=/home/kai/dev/cyvl/build/starship.toml

# CloudCompare
alias cc="flatpak run org.cloudcompare.CloudCompare"

# OBS
alias obs="flatpak run com.obsproject.Studio"

# Tailscale
alias ts="tailscale"

# Go
export PATH="$PATH:/usr/local/go/bin"
export PATH="$PATH:$HOME/go/bin"

# fastfetch
alias ff="fastfetch"

# bun completions
[ -s "/home/kai/.bun/_bun" ] && source "/home/kai/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# CUDA
export PATH="/usr/local/cuda-13.1/bin:$PATH"

export YDOTOOL_SOCKET=/tmp/.ydotool_socket

# Google Cloud SDK

# Update PATH for the Google Cloud SDK.
if [ -f '/home/kai/google-cloud-sdk/path.zsh.inc' ]; then . '/home/kai/google-cloud-sdk/path.zsh.inc'; fi

# Enable shell command completion for gcloud.
if [ -f '/home/kai/google-cloud-sdk/completion.zsh.inc' ]; then . '/home/kai/google-cloud-sdk/completion.zsh.inc'; fi

# Cyvvy
eval "$(/home/kai/.local/bin/cyvvy shell init zsh)"
eval "$(/home/kai/.local/share/cyvvy/bin/direnv hook zsh)"

# For gws CLI
export PATH="$(npm prefix -g)/bin:$PATH"

# Claude Code: workaround for #49273 (defaultMode: "auto" parsed but not honored)
alias claude='claude --permission-mode auto'
