#!/bin/bash
# Print one line per managed window: pid, virtual desktop, window class, caption,
# then the x and y of the window's centre, which is what says which screen it is
# on, then KWin's own id for the window, the one thing that tells two windows of
# one process apart, then 1 if the window is minimized and 0 if it is showing.
#
# A virtual desktop of -1 means the window is on all of them.
#
# KWin has no read API on the session bus. The window-list-publisher KWin
# script stays loaded and hands the list to window-list-service.py whenever a
# window changes, which keeps it in a file; this prints that file. Nothing here
# loads a script into KWin: doing that every couple of seconds crashed it.

set -u

SNAPSHOT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kwin-window-list"
# The publisher rewrites the file at least every 5 seconds. Older than this
# means it is not running, and an old list is worse than none.
MAX_AGE=15

[[ -s "$SNAPSHOT" ]] || exit 1
age=$(( $(date +%s) - $(stat -c %Y "$SNAPSHOT") ))
(( age <= MAX_AGE )) || exit 1

cat "$SNAPSHOT"
